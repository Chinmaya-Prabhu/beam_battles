    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "MaterialService": {
      "GoldStatue": {
        "$className": "MaterialVariant",
        "$properties": {
          "BaseMaterial": "Metal",
          "ColorMap": "rbxassetid://85513431633710",
          "StudsPerTile": 8
        }
      }
    },
    "ServerStorage": {
      "Horizon": {
        "$path": "assets/models/Horizon.rbxmx"
